<Window x:Class="CodexDreamSkin.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:infra="clr-namespace:CodexDreamSkin.Launcher.Infrastructure"
        mc:Ignorable="d"
        Title="Codex Desktop 启动器"
        Icon="Assets/launcher.ico"
        Width="1240"
        Height="660"
        MinWidth="1080"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#FBFAFC"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Window.Resources>
    <infra:StringEqualsConverter x:Key="StringEqualsConverter" />
    <infra:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    <infra:StatusBrushConverter x:Key="StatusBrushConverter" />
    <infra:StatusTextConverter x:Key="StatusTextConverter" />
    <infra:ModeTextConverter x:Key="ModeTextConverter" />
    <infra:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    <infra:SubtractConverter x:Key="SubtractConverter" />

    <SolidColorBrush x:Key="AccentBrush" Color="#E86F9E" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFF0F5" />
    <SolidColorBrush x:Key="AccentLineBrush" Color="#F2B3CA" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelBrush" Color="#F8F7F9" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E4E2E6" />
    <SolidColorBrush x:Key="TextBrush" Color="#22242A" />
    <SolidColorBrush x:Key="MutedBrush" Color="#70747C" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E04F5F" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="MutedTextStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="BaseButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="13,0" />
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFF6F9" />
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentLineBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#FDE8F0" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#D95F8E" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#C95280" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
      <Setter Property="BorderBrush" Value="#F1BCC3" />
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="2,0" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>

    <Style x:Key="ModeRadioStyle" TargetType="RadioButton">
      <Setter Property="Height" Value="36" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="ModeBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ModeBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="#B63C71" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{StaticResource AccentLineBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SidebarItemStyle" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="8,3" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="ItemBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#FCF3F7" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentLineBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="InstanceRowStyle" TargetType="ListViewItem">
      <Setter Property="Height" Value="78" />
      <Setter Property="Margin" Value="6,2" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#ECEAED" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="RowBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
              <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}"
                                    Content="{TemplateBinding Content}"
                                    VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RowBorder" Property="Background" Value="#FFFAFC" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource AccentLineBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="GridViewColumnHeader">
      <Setter Property="Height" Value="42" />
      <Setter Property="Background" Value="#F8F7F9" />
      <Setter Property="BorderBrush" Value="#E9E7EA" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="72" />
      <RowDefinition Height="*" />
      <RowDefinition Height="44" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="18,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="240" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
          <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                   Padding="38,7,10,7"
                   AutomationProperties.Name="搜索实例"
                   ToolTip="搜索实例、端口、地址或状态" />
          <iconPacks:PackIconLucide Kind="Search" Width="17" Height="17"
                                      Foreground="{StaticResource MutedBrush}"
                                      Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                      IsHitTestVisible="False" />
        </Grid>

        <Button Grid.Column="1" Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0"
                Click="ScanInstances_Click" ToolTip="重新扫描 apicodex profile" AutomationProperties.Name="扫描本地实例">
          <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconLucide Kind="ScanLine" Width="17" Height="17" Margin="0,0,8,0" />
            <TextBlock Text="扫描本地实例" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0"
                Click="AddProfile_Click" ToolTip="通过 apicodex 安全流程添加 API profile" AutomationProperties.Name="添加实例">
          <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconLucide Kind="Plus" Width="17" Height="17" Margin="0,0,8,0" />
            <TextBlock Text="添加实例" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Grid.Column="3" Style="{StaticResource BaseButtonStyle}"
                Click="RefreshStatus_Click" ToolTip="刷新全部实例状态" AutomationProperties.Name="刷新状态">
          <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconLucide Kind="RefreshCw" Width="17" Height="17" Margin="0,0,8,0" />
            <TextBlock Text="刷新状态" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#F1FAF5" BorderBrush="#BCE6CD" BorderThickness="1" CornerRadius="5"
                  Padding="9,5" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal">
              <iconPacks:PackIconLucide Kind="ShieldCheck" Width="15" Height="15" Foreground="#17864B" />
              <TextBlock Text="登录环境受保护" Foreground="#17864B" FontSize="12" Margin="6,0,0,0" />
            </StackPanel>
          </Border>
          <Button Style="{StaticResource BaseButtonStyle}" Click="Settings_Click" ToolTip="打开启动器设置目录">
            <StackPanel Orientation="Horizontal">
              <iconPacks:PackIconLucide Kind="Settings" Width="17" Height="17" Margin="0,0,7,0" />
              <TextBlock Text="设置" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <ProgressBar Grid.Row="0" Height="2" VerticalAlignment="Bottom" IsIndeterminate="True"
                 Foreground="{StaticResource AccentBrush}"
                 Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}}" />

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="190" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="300" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#FCFBFD" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="15,0">
            <TextBlock Text="账号与实例" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Instances.Count}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" />
          </Grid>

          <ListBox Grid.Row="1"
                   ItemsSource="{Binding FilteredInstances}"
                   SelectedItem="{Binding SelectedInstance}"
                   ItemContainerStyle="{StaticResource SidebarItemStyle}"
                   Background="Transparent"
                   BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Height="74" Margin="10,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="34" Height="34" CornerRadius="17" Background="#F4A0BE" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AvatarText}" Foreground="White" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="8,13,0,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" MaxWidth="112" />
                      <Ellipse Width="7" Height="7" Margin="7,5,0,0"
                               Fill="{Binding StatusCode, Converter={StaticResource StatusBrushConverter}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                      <Border Background="#F5F4F6" BorderBrush="#E2E0E4" BorderThickness="1" CornerRadius="3" Padding="5,2">
                        <TextBlock Text="{Binding TypeLabel}" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                      </Border>
                      <TextBlock Text="{Binding Port}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="7,2,0,0" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Button Grid.Row="2" Style="{StaticResource BaseButtonStyle}" Margin="14,12"
                  Click="AddProfile_Click">
            <StackPanel Orientation="Horizontal">
              <iconPacks:PackIconLucide Kind="UserRoundPlus" Width="17" Height="17" Margin="0,0,8,0" />
              <TextBlock Text="管理 API profile" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <Grid Grid.Column="1" Background="#FBFAFC" ClipToBounds="True"
            MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SubtractConverter}, ConverterParameter=490}">
        <Grid.RowDefinitions>
          <RowDefinition Height="48" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
          <Grid Margin="16,0">
            <TextBlock Text="实例列表" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <TextBlock Text="运行 " Foreground="{StaticResource MutedBrush}" FontSize="12" />
              <TextBlock Text="{Binding RunningCount}" Foreground="#18864C" FontSize="12" FontWeight="SemiBold" />
              <TextBlock Text="  ·  异常 " Foreground="{StaticResource MutedBrush}" FontSize="12" />
              <TextBlock Text="{Binding AttentionCount}" Foreground="{StaticResource DangerBrush}" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>
          </Grid>
        </Border>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding FilteredInstances}"
                  SelectedItem="{Binding SelectedInstance}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  RowHeight="78"
                  ColumnHeaderHeight="42"
                  Background="Transparent"
                  BorderThickness="0"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#ECEAED"
                  VerticalGridLinesBrush="Transparent"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
          <DataGrid.Resources>
            <Style TargetType="DataGridRow">
              <Setter Property="Background" Value="White" />
              <Setter Property="BorderBrush" Value="#ECEAED" />
              <Setter Property="BorderThickness" Value="0,0,0,1" />
              <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#FFFAFC" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                  <Setter Property="BorderBrush" Value="{StaticResource AccentLineBrush}" />
                </Trigger>
              </Style.Triggers>
            </Style>
            <Style TargetType="DataGridCell">
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="Padding" Value="6,0" />
              <Setter Property="VerticalContentAlignment" Value="Center" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
              </Style.Triggers>
            </Style>
            <Style TargetType="DataGridColumnHeader">
              <Setter Property="Background" Value="#F8F7F9" />
              <Setter Property="BorderBrush" Value="#E9E7EA" />
              <Setter Property="BorderThickness" Value="0,0,1,1" />
              <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
              <Setter Property="FontSize" Value="12" />
              <Setter Property="FontWeight" Value="Normal" />
              <Setter Property="Padding" Value="10,0" />
              <Setter Property="HorizontalContentAlignment" Value="Left" />
              <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
          </DataGrid.Resources>
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="实例名称" Width="105">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding InstanceId}" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="类型 / 地址" Width="130">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding TypeLabel}" />
                    <TextBlock Text="{Binding BaseUrl}" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="状态" Width="90">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Margin="0,0,7,0"
                             Fill="{Binding StatusCode, Converter={StaticResource StatusBrushConverter}}" />
                    <TextBlock Text="{Binding StatusCode, Converter={StaticResource StatusTextConverter}}"
                               VerticalAlignment="Center" FontSize="12" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="端口" Width="54" Binding="{Binding Port}" />
            <DataGridTextColumn Header="主题" Width="75" Binding="{Binding ThemeName}" />
            <DataGridTemplateColumn Header="模式" Width="62">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Mode, Converter={StaticResource ModeTextConverter}}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="背景" Width="68">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Width="54" Height="42" CornerRadius="5" ClipToBounds="True" Background="#EEECEF">
                    <Image Source="{Binding PreviewImage}" Stretch="UniformToFill" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="皮肤" Width="54">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding SkinStatusText}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#D47A18" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding SkinRunning}" Value="True">
                            <Setter Property="Foreground" Value="#198B4E" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="操作" Width="132">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                      <Button Style="{StaticResource IconButtonStyle}" Tag="{Binding}" Click="StartInstance_Click" ToolTip="启动或重启" AutomationProperties.Name="启动实例">
                      <iconPacks:PackIconLucide Kind="Play" Width="15" Height="15" />
                    </Button>
                      <Button Style="{StaticResource IconButtonStyle}" Tag="{Binding}" Click="StopInstance_Click" ToolTip="停止实例" AutomationProperties.Name="停止实例">
                      <iconPacks:PackIconLucide Kind="Square" Width="14" Height="14" />
                    </Button>
                      <Button Style="{StaticResource IconButtonStyle}" Tag="{Binding}" Click="VerifyInstance_Click" ToolTip="验证皮肤" AutomationProperties.Name="验证皮肤">
                      <iconPacks:PackIconLucide Kind="ShieldCheck" Width="15" Height="15" />
                    </Button>
                      <Button Style="{StaticResource IconButtonStyle}" Tag="{Binding}" Click="OpenLogs_Click" ToolTip="打开日志" AutomationProperties.Name="打开日志">
                      <iconPacks:PackIconLucide Kind="Logs" Width="15" Height="15" />
                    </Button>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>

      <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
              <TextBlock Text="实例详情 / 配置" FontWeight="SemiBold" VerticalAlignment="Center" />
              <iconPacks:PackIconLucide Kind="PanelRight" Width="17" Height="17"
                                          Foreground="{StaticResource MutedBrush}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
          </Border>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="18,14,18,18" DataContext="{Binding SelectedInstance}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" MaxWidth="210" />
                <Border Background="#EFF9F3" BorderBrush="#BCE6CC" BorderThickness="1" CornerRadius="4"
                        Padding="7,3" Margin="10,0,0,0" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Margin="0,0,5,0"
                             Fill="{Binding StatusCode, Converter={StaticResource StatusBrushConverter}}" />
                    <TextBlock Text="{Binding StatusCode, Converter={StaticResource StatusTextConverter}}"
                               Foreground="#177F48" FontSize="11" />
                  </StackPanel>
                </Border>
              </StackPanel>
              <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentLineBrush}"
                      BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,9,0,18"
                      HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                  <iconPacks:PackIconLucide Kind="ShieldCheck" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" />
                  <TextBlock Text="{Binding ProtectionLabel}" Foreground="#B23D70" FontSize="11" Margin="5,0,0,0" />
                </StackPanel>
              </Border>

              <TextBlock Text="基本信息" Style="{StaticResource SectionTitleStyle}" />
              <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="82" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="28" />
                  <RowDefinition Height="28" />
                  <RowDefinition Height="28" />
                  <RowDefinition Height="28" />
                  <RowDefinition Height="28" />
                </Grid.RowDefinitions>
                <TextBlock Text="实例类型" Style="{StaticResource MutedTextStyle}" />
                <TextBlock Grid.Column="1" Text="{Binding TypeLabel}" />
                <TextBlock Grid.Row="1" Text="监听端口" Style="{StaticResource MutedTextStyle}" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                  <TextBlock Text="{Binding Port}" />
                  <Button Style="{StaticResource IconButtonStyle}" Width="24" Height="24" Margin="8,-3,0,0"
                          Click="ChangePort_Click" ToolTip="修改端口" AutomationProperties.Name="修改端口">
                    <iconPacks:PackIconLucide Kind="Pencil" Width="12" Height="12" />
                  </Button>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="最后验证" Style="{StaticResource MutedTextStyle}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastVerifiedText}" />
                <TextBlock Grid.Row="3" Text="CDP 状态" Style="{StaticResource MutedTextStyle}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CdpStatusText}" />
                <TextBlock Grid.Row="4" Text="数据目录" Style="{StaticResource MutedTextStyle}" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DetailPath}" ToolTip="{Binding DetailPath}" />
              </Grid>

              <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,17" />
              <TextBlock Text="背景图设置" Style="{StaticResource SectionTitleStyle}" />
              <Border Height="154" Background="#F0EEF1" CornerRadius="6" ClipToBounds="True">
                <Grid>
                  <Image Source="{Binding PreviewImage}" Stretch="UniformToFill" />
                  <Border VerticalAlignment="Bottom" Background="#BFFFFFFF" Padding="9,6">
                    <TextBlock Text="{Binding ImagePath}" FontSize="11" Foreground="#4E5157" />
                  </Border>
                </Grid>
              </Border>
              <Grid Margin="0,10,0,18">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource BaseButtonStyle}" Click="ChooseBackground_Click" AutomationProperties.Name="更换背景">
                  <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Kind="Image" Width="16" Height="16" Margin="0,0,7,0" />
                    <TextBlock Text="更换背景" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource BaseButtonStyle}" Click="ClearBackground_Click" AutomationProperties.Name="清除背景">
                  <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Kind="Trash2" Width="16" Height="16" Margin="0,0,7,0" />
                    <TextBlock Text="清除背景" />
                  </StackPanel>
                </Button>
              </Grid>

              <TextBlock Text="个性化设置" Style="{StaticResource SectionTitleStyle}" />
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="62" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="主题" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding DataContext.Themes, RelativeSource={RelativeSource AncestorType=Window}}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding ThemeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </Grid>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="62" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="显示模式" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                <RadioButton Grid.Column="1" GroupName="DisplayMode" Content="整窗背景"
                             Style="{StaticResource ModeRadioStyle}"
                             IsChecked="{Binding Mode, Converter={StaticResource StringEqualsConverter}, ConverterParameter=full-window, Mode=TwoWay}" />
                <RadioButton Grid.Column="2" GroupName="DisplayMode" Content="主页卡片" Margin="6,0,0,0"
                             Style="{StaticResource ModeRadioStyle}"
                             IsChecked="{Binding Mode, Converter={StaticResource StringEqualsConverter}, ConverterParameter=home-card, Mode=TwoWay}" />
              </Grid>
              <Button Style="{StaticResource PrimaryButtonStyle}" Click="ApplyAppearance_Click" Margin="0,0,0,18" AutomationProperties.Name="应用外观设置">
                <StackPanel Orientation="Horizontal">
                  <iconPacks:PackIconLucide Kind="Sparkles" Width="16" Height="16" Margin="0,0,8,0" />
                  <TextBlock Text="应用外观设置" Foreground="White" />
                </StackPanel>
              </Button>

              <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,17" />
              <TextBlock Text="维护操作" Style="{StaticResource SectionTitleStyle}" />
              <UniformGrid Columns="4" Margin="0,0,0,10">
                <Button Style="{StaticResource BaseButtonStyle}" Margin="0,0,5,0" Click="StartSelected_Click" ToolTip="启动或重启" AutomationProperties.Name="启动选中实例">
                  <iconPacks:PackIconLucide Kind="Play" Width="16" Height="16" />
                </Button>
                <Button Style="{StaticResource BaseButtonStyle}" Margin="2,0" Click="StopSelected_Click" ToolTip="停止实例" AutomationProperties.Name="停止选中实例">
                  <iconPacks:PackIconLucide Kind="Square" Width="15" Height="15" />
                </Button>
                <Button Style="{StaticResource BaseButtonStyle}" Margin="5,0,2,0" Click="RestoreSelected_Click" ToolTip="恢复无皮肤" AutomationProperties.Name="恢复无皮肤">
                  <iconPacks:PackIconLucide Kind="RotateCcw" Width="16" Height="16" />
                </Button>
                <Button Style="{StaticResource BaseButtonStyle}" Margin="5,0,0,0" Click="VerifySelected_Click" ToolTip="验证皮肤" AutomationProperties.Name="验证选中实例">
                  <iconPacks:PackIconLucide Kind="ShieldCheck" Width="16" Height="16" />
                </Button>
              </UniformGrid>
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource BaseButtonStyle}" Click="EditProfile_Click"
                        IsEnabled="{Binding CanManageProfile}">
                  <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Kind="Pencil" Width="15" Height="15" Margin="0,0,7,0" />
                    <TextBlock Text="编辑实例" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource DangerButtonStyle}" Click="RemoveProfile_Click"
                        IsEnabled="{Binding CanManageProfile}">
                  <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Kind="Trash2" Width="15" Height="15" Margin="0,0,7,0" />
                    <TextBlock Text="移除实例" Foreground="{StaticResource DangerBrush}" />
                  </StackPanel>
                </Button>
              </Grid>
              <Button Style="{StaticResource BaseButtonStyle}" Click="OpenSelectedLogs_Click" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                  <iconPacks:PackIconLucide Kind="FolderOpen" Width="16" Height="16" Margin="0,0,8,0" />
                  <TextBlock Text="打开状态与日志目录" />
                </StackPanel>
              </Button>

              <Border Background="#F7FAFC" BorderBrush="#DCE5EB" BorderThickness="1" CornerRadius="5" Padding="10">
                <StackPanel Orientation="Horizontal">
                  <iconPacks:PackIconLucide Kind="CircleCheck" Width="15" Height="15" Foreground="#4E7790" />
                  <TextBlock Text="界面不会显示 API Key、Cookie 或其他敏感信息"
                             Foreground="#587184" FontSize="11" Margin="7,0,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Background="#FFF6F7" BorderBrush="#F3C7CE" BorderThickness="1" CornerRadius="5"
                      Padding="10" Margin="0,10,0,0"
                      Visibility="{Binding LastError, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding LastError}" Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="18,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <iconPacks:PackIconLucide Kind="Activity" Width="16" Height="16" Foreground="#4D5660" />
          <TextBlock Text="状态汇总" FontWeight="SemiBold" Margin="7,0,0,0" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="API 实例 " Foreground="{StaticResource MutedBrush}" Margin="24,0,0,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding ApiInstanceCount}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" Margin="26,0,0,0" VerticalAlignment="Center" />
        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="上次刷新：" Foreground="{StaticResource MutedBrush}" />
          <TextBlock Text="{Binding LastRefreshText}" Foreground="{StaticResource MutedBrush}" />
          <Ellipse Width="8" Height="8" Fill="#1BA05A" Margin="16,0,6,0" />
          <TextBlock Text="本地连接正常" Foreground="#27714B" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
